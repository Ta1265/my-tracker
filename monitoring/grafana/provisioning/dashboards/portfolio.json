          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "showLegend": true
        }
      },
      "description": "Aggregated by (le, job). Dropping job here would sum two services' histograms into one distribution that describes neither."

          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_ms_bucket{job=~\"$job\", path!=\"/backend/api/metrics\"}[5m])) by (le, job))",
          "legendFormat": "p99 {{job}}",
          "refId": "C"

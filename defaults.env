ENV_VARIABLE=production_server_only_variable
NEXT_PUBLIC_ENV_VARIABLE=production_public_variable
NEXTAUTH_URL=https://www.tubesock.xyz

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=PORTFOLIO

# Read only by the frontend's legacy Prisma client (frontend/src/server/db/schema.prisma).
# The backend reads the DB_* variables below and ignores this one - overriding it alone
# will not repoint nest-api.
DATABASE_URL=mysql://root:root@portfolio-db:3306/PORTFOLIO

DB_HOST=portfolio-db
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=PORTFOLIO
MYSQLDB_LOCAL_PORT=3306
MYSQLDB_DOCKER_PORT=3306

PRICE_PROVIDER=coingecko
SWAGGER_ENABLED=true

# X_CG_DEMO_API_KEY=
# COINGECKO_API_KEY=

NEXTAUTH_SECRET=
METRICS_SECRET=
GF_SECURITY_ADMIN_PASSWORD=
SESSION_PRIVATE_KEY_JWK=
SESSION_PUBLIC_KEY_JWK=

    "/backend/api/metrics": {
      "get": {
        "description": "Authenticated via a static bearer-token check (Authorization: Bearer {METRICS_SECRET}), not a session - this is a machine-to-machine scrape credential, never a user-facing route, so it is documented with its own bearer security scheme rather than @ApiCookieAuth().",
        "operationId": "MetricsController_getMetrics",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Prometheus text exposition format",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Missing/incorrect bearer token, or METRICS_SECRET unset.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "Forbidden"
                }
              }
            }
          }
        },
        "security": [
          {
            "metrics-secret": []
          }
        ],
        "summary": "",
        "tags": [
          "Metrics"
        ]
      }
    }

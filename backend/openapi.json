  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "portfolio_session"
      },
      "metrics-secret": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "jdoe"
          },
          "password": {
            "type": "string",
            "example": "hunter2"
          },
          "rememberMe": {
            "type": "boolean",
            "example": false,
            "description": "Requests a 30-day session lifetime instead of the default 8h."

    "/backend/api/transaction/{id}": {
      "delete": {
        "description": "Delete the caller's transaction by id.",
        "operationId": "TransactionsController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The transaction's numeric id, as a string.",
            "schema": {
              "example": "1",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Transaction deleted."
          },
          "400": {
            "description": "Missing id parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "error": "Missing id parameter"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No session.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "error": "Unauthorized"
                  }
                }
              }
            }
          },
          "500": {
            "description": "The delete failed (e.g. no row with that id - there is no existence check).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "error": "An error occurred while deleting the transaction"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "",
        "tags": [
          "Transactions"
        ]
      }
    },

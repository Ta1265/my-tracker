    "/backend/api/token-info/{userId}": {
      "get": {
        "description": "This route's name is misleading - it does not return token info, it triggers a price-history sync (a database write) keyed by the given userId. Requires a session, with the sync scoped to the authenticated caller's own id - an id/session mismatch is rejected rather than trusting the path param.",
        "operationId": "TokenInfoController_sync",
        "parameters": [
          {
            "name": "userId",
            "required": true,
            "in": "path",
            "schema": {
              "example": "1",

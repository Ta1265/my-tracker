    "/backend/api/exchange-rates/unit/{unit}": {
      "get": {
        "description": "Deliberately public: returns a market exchange rate, not anything scoped to the caller. No auth today; stays public.",
        "operationId": "ExchangeRatesController_getByUnit",
        "parameters": [
          {
            "name": "unit",
            "required": true,
            "in": "path",
            "schema": {
              "example": "BTC",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "formatUSD-formatted exchange rate, as a bare JSON string (not a wrapped object).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "\"$1,235\""
              }
            }
          },
          "404": {
            "description": "No ExchangeRate row for the unit, as a bare JSON string (not a wrapped object).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "\"Exchange rate not found\""
              }
            }
          }
        },
        "summary": "",
        "tags": [
          "Exchange Rates"
        ]
      }
    },

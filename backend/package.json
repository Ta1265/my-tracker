{
  "name": "@portfolio/backend",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "nest start --exec \"node --env-file-if-exists=../defaults.env --env-file-if-exists=../override.env\"",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=../defaults.env --env-file-if-exists=../override.env\"",
    "start:prod": "node --env-file-if-exists=../defaults.env --env-file-if-exists=../override.env dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\""
  },
  "dependencies": {
    "@mikro-orm/core": "7.1.12",
    "@mikro-orm/decorators": "7.1.12",
    "@mikro-orm/mysql": "7.1.12",
    "@mikro-orm/nestjs": "^7.0.2",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "@portfolio/shared": "workspace:*",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dayjs": "^1.11.10",
    "ioredis": "^5.4.1",
    "nest-winston": "^1.10.2",
    "nestjs-cls": "^6.2.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mikro-orm/cli": "7.1.12",
    "@mikro-orm/entity-generator": "7.1.12",
    "@nestjs/cli": "^11.0.0",
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0"
  }
}

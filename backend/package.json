{
  "name": "@portfolio/backend",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start --exec \"node --env-file-if-exists=../defaults.env --env-file-if-exists=../override.env\"",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=../defaults.env --env-file-if-exists=../override.env\"",
    "start:prod": "node --env-file-if-exists=../defaults.env --env-file-if-exists=../override.env dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
